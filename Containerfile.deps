# syntax=docker/dockerfile:1.7
#
# Base/deps image for tang-arm-docker. Contains everything expensive to
# rebuild: a source-built no-shared OpenSSL, jansson, zlib, http_parser,
# and jose, all as static libs under /opt/staticlibs with a matching
# jose.pc. The main Containerfile FROMs this image and only builds tang
# itself against it, so an ordinary tang-only iteration doesn't have to
# recompile OpenSSL every time. Rebuild this image (via build-deps.yml)
# only when dependency versions or link flags actually change.

ARG ALPINE_VERSION=3.21
ARG OPENSSL_VERSION=3.3.2
ARG JOSE_VERSION=14
ARG HTTP_PARSER_VERSION=2.9.4

FROM alpine:${ALPINE_VERSION}
ARG OPENSSL_VERSION
ARG JOSE_VERSION
ARG HTTP_PARSER_VERSION

RUN apk add --no-cache \
    build-base curl meson ninja pkgconf perl linux-headers \
    jansson-dev jansson-static \
    zlib-dev zlib-static

# OpenSSL, built from source with no-shared into an isolated prefix.
#
# Alpine's own openssl-libs-static package still expects its "default"
# crypto provider to be loaded at runtime as a separate .so module via
# dlopen(), which is how OpenSSL 3.x normally works. A fully -static
# binary has no dynamic linker at all, so that dlopen() call has nothing
# to do, algorithm implementations silently come up empty, and key
# generation fails the moment it's actually exercised ("Error generating
# JWK with alg ES512" at runtime). no-shared bakes the default provider
# directly into libcrypto.a instead, so there is no runtime
# module-loading step to fail.
#
# Kept in its own prefix (/opt/ossl-static), not /usr, so it never
# touches Alpine's own dynamic libssl/libcrypto that curl and other
# system tools in this build stage depend on.
RUN curl -fL https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz | tar xz -C /tmp \
 && cd /tmp/openssl-${OPENSSL_VERSION} \
 && ./Configure linux-aarch64 no-shared no-tests \
      --prefix=/opt/ossl-static --openssldir=/opt/ossl-static/ssl \
 && make -j"$(nproc)" \
 && make install_sw \
 && rm -rf /tmp/openssl-${OPENSSL_VERSION}

# http_parser (tang's fallback HTTP lib; simpler to vendor than llhttp's codegen step)
RUN curl -fL https://github.com/nodejs/http-parser/archive/refs/tags/v${HTTP_PARSER_VERSION}.tar.gz | tar xz -C /tmp \
 && cd /tmp/http-parser-${HTTP_PARSER_VERSION} \
 && gcc -c http_parser.c -o http_parser.o \
 && ar rcs libhttp_parser.a http_parser.o \
 && cp libhttp_parser.a /usr/lib/ \
 && cp http_parser.h /usr/include/ \
 && rm -rf /tmp/http-parser-${HTTP_PARSER_VERSION}

# jose - upstream meson.build always builds a shared library regardless of
# --default-library, so build it normally, then archive its already-compiled
# objects into a static .a ourselves for tang's fully-static link.
# PKG_CONFIG_PATH adds our source-built static openssl on top of the
# default search path (which already has Alpine's jansson.pc).
RUN curl -fL https://github.com/latchset/jose/archive/refs/tags/v${JOSE_VERSION}.tar.gz | tar xz -C /tmp \
 && cd /tmp/jose-${JOSE_VERSION} \
 && PKG_CONFIG_PATH=/opt/ossl-static/lib/pkgconfig meson setup build --prefix=/usr \
 && ninja -C build install \
 && ar rcs /usr/lib/libjose.a build/lib/libjose.so.*.p/*.c.o \
 && rm -rf /tmp/jose-${JOSE_VERSION}

# OpenSSL's built-in "default" provider is registered through a static
# (file-scoped, not exported) table that lives in its own translation
# unit. A normal static link only pulls in the .o files needed to
# resolve symbols something else actually calls; since nothing outside
# that file can reference the table directly, and our actual call chain
# (jose_jwk_gen -> EVP_PKEY_CTX_new_from_name -> provider fetch) doesn't
# happen to touch the one exported function that would pull it in, the
# linker drops that object file, table and all. This is what caused
# "Error generating JWK with alg ES512" at runtime, confirmed via an
# Alpine-vs-scratch A/B test that isolated it to the -static link
# itself, not the base image or the OpenSSL build.
#
# Rather than force-including the whole of libcrypto/libssl/libjose with
# --whole-archive (works, but disables dead-code elimination for the
# entire dependency chain, bloating the binary from ~280KB to ~5.7MB),
# this tiny shim makes one direct, real call to
# OSSL_PROVIDER_load(NULL, "default") at process startup. That's a
# genuine function-level reference into the same code path, so the
# linker includes it through normal symbol resolution, no whole-archive
# needed for OpenSSL itself. Only this few-hundred-byte shim needs to be
# force-included, to guarantee the constructor actually runs.
RUN printf '#include <openssl/provider.h>\nstatic void __attribute__((constructor)) force_default_provider(void) {\n    OSSL_PROVIDER_load(NULL, "default");\n}\n' > /tmp/force_provider.c \
 && gcc -c /tmp/force_provider.c -I/opt/ossl-static/include -o /tmp/force_provider.o \
 && ar rcs /usr/lib/libforceprovider.a /tmp/force_provider.o

# Private static-only library directory + hand-written jose.pc, rather
# than deleting the system .so files (curl and python/meson are
# themselves dynamically linked against libz/libssl/libcrypto, so
# removing those broke the toolchain in an earlier attempt). jose's real
# .pc only exposes -lcrypto/-lssl/-lz under a "--static" pkg-config
# query, which tang's plain dependency('jose', ...) call never makes, so
# those need to be listed unconditionally here too.
#
# Only libforceprovider is wrapped in --whole-archive (see the comment
# above where it's built), so it's guaranteed to be linked in regardless
# of whether anything else directly references its one symbol. Everything
# else links normally, full dead-code elimination intact.
RUN mkdir -p /opt/staticlibs/pkgconfig \
 && cp /usr/lib/libjose.a /usr/lib/libjansson.a /opt/ossl-static/lib/libssl.a /opt/ossl-static/lib/libcrypto.a /usr/lib/libz.a /usr/lib/libhttp_parser.a /usr/lib/libforceprovider.a /opt/staticlibs/ \
 && printf 'libdir=/opt/staticlibs\nincludedir=/usr/include\n\nName: jose\nDescription: static jose\nVersion: %s\nCflags: -I${includedir}\nLibs: -L${libdir} -Wl,--whole-archive -lforceprovider -Wl,--no-whole-archive -ljose -ljansson -lssl -lcrypto -lz\n' "${JOSE_VERSION}" > /opt/staticlibs/pkgconfig/jose.pc
